    {
      "conversation_id": "conv_1791357197680_vneof",
      "sender": "user",
      "message": "Saya membutuhkan bantuan untuk riset pasar, strategi masuk pasar baru, atau business matching.",
      "intent": "market_access",
      "id": "msg_1791357197683_ganni",
